{
  "name": "omniproxy",
  "version": "0.1.2",
  "private": true,
  "description": "Universal relay for provider web APIs — OpenAI/Anthropic/Gemini-compatible gateway over web chat interfaces",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "legacy:start": "node legacy/server.js",
    "legacy:test": "pnpm --filter free-deepseek-api test",
    "legacy:doctor": "node legacy/scripts/doctor.js",
    "legacy:auth": "node legacy/scripts/auth.js"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shirou-eh/OmniProxy.git"
  },
  "homepage": "https://github.com/shirou-eh/OmniProxy#readme",
  "bugs": {
    "url": "https://github.com/shirou-eh/OmniProxy/issues"
  },
  "keywords": [
    "omniproxy",
    "proxy",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "gateway",
    "provider",
    "web-api"
  ]
}
